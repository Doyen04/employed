# HTTP server
PORT=8000
CORS_ORIGIN=http://localhost:3000

# Postgres (managed: Railway / Supabase)
DATABASE_URL="postgresql://username:password@localhost:5432/employed"

# Internal API auth — dashboard sends this as: Authorization: Bearer <WORKER_API_KEY>
WORKER_API_KEY=generate-a-long-random-string

# AES-256-GCM key for encrypting the Telegram session and notifier secrets at rest
ENCRYPTION_KEY=at-least-16-characters-secret

# Telegram app credentials (my.telegram.org)
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# LLM analysis (Groq primary, OpenRouter backup, both via the OpenAI SDK)
# Primary = Groq. It runs native json_schema structured output (strict:false / best-effort),
# auto-degrading to JSON Object Mode (then plain) if the model or provider rejects the format.
# openai/gpt-oss-120b supports json_schema; gpt-oss-20b and qwen/qwen3.8-27b too.
# Models WITHOUT structured-output support (e.g. llama-3.3-70b-versatile) are served via
# JSON Object Mode instead — still valid JSON, staged through the parse fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELS=openai/gpt-oss-120b
# Backup = OpenRouter. Used on ANY Groq error — every 429 (even daily-limit "wait a few
# minutes") routes here immediately, no waiting. Groq is then cooled down and skipped for
# LLM_PROVIDER_COOLDOWN_MS so we don't hammer the rate limit.
LLM_BACKUP_API_KEY=
LLM_BACKUP_BASE_URL=https://openrouter.ai/api/v1
LLM_BACKUP_MODEL=openrouter/free
# How long a rate-limited provider is skipped in the rotation (ms). Default 300000 (5 min).
LLM_PROVIDER_COOLDOWN_MS=300000
# A comma-separated list also works; extra entries are OpenRouter-model fallbacks and only
# apply when the base URL is openrouter.ai.

# SMTP for the email notifier — per-notifier config keys (host, port, secure, user, pass, from) override these
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=alerts@example.com

# Socket.io realtime auth uses WORKER_API_KEY (same token for the HTTP API and the socket handshake — connect with auth: { token: WORKER_API_KEY })


# Caveats worth knowing:
# - It only ever fetches one batch of 50 per restart per chat — if more than 50 were missed while offline, the rest is picked up on the next restart (since each row advances the watermark). No multi-page loop today.
# - This is the account's own dialog history — the session must be authorized for the monitored chat; title resolution may fall back to the numeric ID for groups/channels it can't name.
# - New chats with no watermark (lastSeen == null) are skipped entirely — backfill needs an anchor to know where to start.