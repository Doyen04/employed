# HTTP server
PORT=8000
CORS_ORIGIN=http://localhost:3000

# Postgres (managed: Railway / Supabase)
DATABASE_URL="postgresql://username:password@localhost:5432/employed"

# Internal API auth — dashboard sends this as: Authorization: Bearer <WORKER_API_KEY>
WORKER_API_KEY=generate-a-long-random-string

# AES-256-GCM key for encrypting the Telegram session and notifier secrets at rest
ENCRYPTION_KEY=at-least-16-characters-secret

# Telegram app credentials (my.telegram.org)
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# LLM analysis (OpenRouter via the OpenAI SDK)
# openrouter/free = the Free Models Router: OpenRouter auto-selects a free model per request
# and swaps when one is down. Or set a priority-ordered comma-separated list and the worker
# falls back to the next entry on model errors (rate limit, downtime, moderation refusals).
LLM_API_KEY=
LLM_MODELS=openrouter/free
# A single model id also works (LLM_MODEL=openai/gpt-4o-mini:free).
# LLM_BASE_URL=https://openrouter.ai/api/v1

# SMTP for the email notifier — per-notifier config keys (host, port, secure, user, pass, from) override these
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=alerts@example.com

# Socket.io realtime auth uses WORKER_API_KEY (same token for the HTTP API and the socket handshake — connect with auth: { token: WORKER_API_KEY })


# Caveats worth knowing:
# - It only ever fetches one batch of 50 per restart per chat — if more than 50 were missed while offline, the rest is picked up on the next restart (since each row advances the watermark). No multi-page loop today.
# - This is the account's own dialog history — the session must be authorized for the monitored chat; title resolution may fall back to the numeric ID for groups/channels it can't name.
# - New chats with no watermark (lastSeen == null) are skipped entirely — backfill needs an anchor to know where to start.