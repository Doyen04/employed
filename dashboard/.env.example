# Worker API (private internal API — the dashboard's only data access)
WORKER_URL="http://localhost:8000"
WORKER_API_KEY="change-me"

# Admin login (protects the UI; cookie is HMAC-signed with AUTH_SECRET)
AUTH_SECRET="change-me-to-a-long-random-string"
DASHBOARD_ADMIN_PASSWORD="change-me"

# Browser → worker realtime socket. VITE_* so it reaches the client bundle.
# VITE_WORKER_SOCKET_TOKEN must equal the worker's SOCKET_TOKEN env (defaults to WORKER_API_KEY).
VITE_WORKER_SOCKET_URL="http://localhost:8000"
VITE_WORKER_SOCKET_TOKEN="change-me"

# Server-only envs are read from process.env (dev: Vite/Nitro, prod: Vercel project settings).
# Vite exposes only VITE_-prefixed variables to the browser bundle.