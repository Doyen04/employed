# Worker API (private internal API — the dashboard's only data access)
WORKER_URL="http://localhost:8000"
WORKER_API_KEY="change-me"

# Admin login (single user). The session is a signed JWT (jsonwebtoken) stored in an
# httpOnly cookie; the admin password is a bcrypt hash (bcryptjs) — never set a
# plaintext password here.
# Generate a hash with:  node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
AUTH_SECRET="change-me-to-a-long-random-string"
DASHBOARD_ADMIN_PASSWORD_HASH="$2b$10$ywD1O.uXKYk4ZPPQVzqOxeq7vueNnqmjKp9COhLZW4slSar61aaDa"

# Browser → worker realtime socket. The handshake reuses WORKER_API_KEY (the browser fetches
# it at runtime from the authed getRealtimeToken server function — no token is baked into the
# client bundle). Only the socket URL is a VITE_* browser env.
WORKER_URL="http://localhost:8000"

# Server-only envs are read from process.env (dev: Vite/Nitro, prod: Vercel project settings).
# Vite exposes only VITE_-prefixed variables to the browser bundle.